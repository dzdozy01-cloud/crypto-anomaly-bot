# Copy to `.env` and fill in. Never commit the real `.env`.
#   set -a && source .env && set +a && cadb run -c config.yaml

# ---- Alerting (Telegram bot: talk to @BotFather to create one) ----
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
TELEGRAM_CHAT_ID=-1001234567890
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# ---- Module 2: on-chain RPC endpoints ----
# Comma-separate multiple URLs for automatic failover.
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
BSC_RPC_URL=https://bsc-dataseed.binance.org
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---- Module 3: social APIs ----
X_BEARER_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ---- Infrastructure ----
REDIS_URL=redis://localhost:6379/0
CADB_LOG_LEVEL=INFO

# ---- Runtime overrides (take precedence over config.yaml) ----
# CADB_ALERT_THRESHOLD=85
