# CADB environment.  Copy to `.env`, fill in, then:
#   set -a && source .env && set +a && cadb run -c config.yaml
#
# ONLY the two TELEGRAM_ vars below are needed to receive alerts.
# Everything else has a working default — see docs/SETUP.md.

# ─────────────────────────────────────────────────────────────
# TIER 1 — required for alert delivery
# ─────────────────────────────────────────────────────────────
# From @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=
# Your chat/group/channel id. Personal = positive, group = negative.
#   curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates"
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────────────────────
# TIER 2 — recommended: dedicated RPC endpoints
# Defaults are public nodes: rate-limited, and Module 2 will miss
# blocks under load. Comma-separate for automatic failover.
# ─────────────────────────────────────────────────────────────
ETH_RPC_URL=
BSC_RPC_URL=
SOLANA_RPC_URL=

# ─────────────────────────────────────────────────────────────
# TIER 3 — optional sources (unset = that source is skipped)
# ─────────────────────────────────────────────────────────────
# X/Twitter bearer token — developer.x.com
X_BEARER_TOKEN=

# Telegram MTProto (my.telegram.org/apps) — a USER credential,
# NOT the bot token above. Only needed to scrape public channels;
# also set social.telegram_channels in config.yaml + `pip install telethon`.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Discord webhook — Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────
# TIER 4 — infrastructure
# ─────────────────────────────────────────────────────────────
# Only used when bus.kind=redis in config.yaml.
# Unreachable -> automatic fallback to the in-process bus.
REDIS_URL=redis://localhost:6379/0
CADB_LOG_LEVEL=INFO

# CADB_* overrides beat both config.yaml and the vars above:
#   CADB_ALERT_THRESHOLD=90
#   CADB_TELEGRAM_BOT_TOKEN, CADB_TELEGRAM_CHAT_ID, CADB_DISCORD_WEBHOOK,
#   CADB_X_BEARER_TOKEN, CADB_ETH_RPC, CADB_SOLANA_RPC, CADB_REDIS_URL
